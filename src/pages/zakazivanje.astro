---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Asterisk from '../components/Asterisk.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CrisisNote from '../components/CrisisNote.astro';
import ContactCards from '../components/ContactCards.astro';
import Faq from '../components/Faq.astro';
import { person, practice, formatPhrase, formatChoice } from '../data/practice';
import { serviceNode } from '../lib/schema';

const crumbs = [{ name: 'Početna', href: '/' }, { name: 'Zakazivanje', href: '/zakazivanje/' }];
const channels = person.phone ? 'Email, poziv, SMS, Viber, WhatsApp ili Instagram' : 'Email ili poruka na Instagramu';
const faq = [
  { q: 'Šta ako moram da otkažem?', a: `<p>${practice.cancellation}</p>` },
  { q: 'Da li dolazim u ordinaciju ili je online?', a: `<p>Kako ti više odgovara: seanse su ${formatChoice}.${practice.location.districtIn ? ` Ordinacija je ${practice.location.cityIn}, ${practice.location.districtIn}.` : ''} Termin, tačnu adresu ili link za video poziv dogovaramo u prvoj poruci.</p>` },
  ...(practice.firstSessionFree ? [{ q: 'Da li je prva seansa zaista besplatna?', a: `<p>Da, cela prva seansa od ${practice.sessionMinutes} minuta. Služi da se upoznamo i da vidiš da li ti ovakav rad odgovara, bez obaveze da nastaviš.</p>` }] : []),
  { q: 'Šta da pripremim za prvi razgovor?', a: '<p>Ništa posebno. Ako je online, treba ti mirno mesto gde te niko ne prekida, slušalice i stabilan internet. Ako želiš, zapiši par rečenica o tome šta te muči, ali ne moraš.</p>' },
  { q: 'Šta ako posle prvog razgovora ne želim da nastavim?', a: '<p>To je potpuno u redu i ništa ne moraš da objašnjavaš. Prvi razgovor služi baš tome da proceniš da li ti ovakav rad i ja kao osoba odgovaramo.</p>' },
];
---
<Base
  title="Zakazivanje: email i telefon"
  description={`Zakaži REBT terapiju na srpskom, ${formatPhrase}: piši na email ili pozovi, pošalji SMS, Viber ili WhatsApp. Odgovor stiže sa predlogom termina.`}
  crumbs={crumbs}
  schema={[serviceNode()]}
  faq={faq}
>
  <PageHead
    crumbs={crumbs}
    eyebrow="Zakazivanje"
    tone="lime"
    title="Javi se"
    lead="Napiši ili pozovi, kako ti je lakše. Odgovaram sa predlogom termina, a ti ništa ne moraš da pripremiš."
  />

  <section class="section section--tight" id="kontakt" style="padding-top:0" aria-label="Kontakt">
    <div class="container">
      <ContactCards />
      <p class="small muted" style="margin-top:var(--space-6);max-width:720px">
        {practice.responseTime} {practice.firstSessionFree && 'Prva seansa je besplatna i bez obaveze.'}
        Trajanje, plaćanje i otkazivanje su na stranici <a class="rh-link" href="/kako-radim/#uslovi">kako radim</a>, a <a class="rh-link" href="/privatnost/#poruke">šta se dešava sa tvojom porukom</a> piše u delu o privatnosti.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="prvi-naslov">
    <div class="container editorial">
      <div class="editorial__head stack">
        <Eyebrow tone="lavender">Prvi razgovor</Eyebrow>
        <h2 id="prvi-naslov" class="h2">Šta te čeka kad se prvi put čujemo</h2>
        <p class="muted">Najteži deo je obično poslati prvu poruku. Posle toga je sve jednostavnije nego što izgleda.</p>
      </div>
      <div class="editorial__body">
        <ul class="rh-checks">
          <li><Asterisk tone="lime" size={20} /><p style="margin:0"><strong>Ja vodim razgovor.</strong><span>Postavljam pitanja, a ti pričaš koliko želiš. Ne moraš da znaš odakle da počneš.</span></p></li>
          <li><Asterisk tone="sky" size={20} /><p style="margin:0"><strong>Ne moraš da imaš „pravi“ problem.</strong><span>Dovoljno je da te nešto muči ili da želiš nešto da promeniš.</span></p></li>
          <li><Asterisk tone="lavender" size={20} /><p style="margin:0"><strong>Kažem ti kako bih radila.</strong><span>Na kraju razgovora znaš šta bi bila tema, kako izgleda rad i koliko košta.</span></p></li>
          <li><Asterisk tone="lime" size={20} /><p style="margin:0"><strong>Odluka je tvoja.</strong><span>Možeš da nastaviš, da razmisliš ili da se više ne javiš. Sve tri opcije su u redu.</span></p></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--stone" aria-labelledby="koraci-naslov">
    <div class="container">
      <div class="section-head">
        <Eyebrow tone="sky">Kako ide</Eyebrow>
        <h2 id="koraci-naslov" class="h2">Od poruke do prve seanse</h2>
      </div>
      <ProcessSteps steps={[
        { title: 'Javiš se', text: `${channels}, kako ti je lakše. Dovoljno je ime i kad ti odgovara. Ne pitam za dijagnozu.` },
        { title: 'Dogovorimo termin', text: `Predložim ti termin, ${formatChoice}. Kad ga potvrdiš, stižu adresa ili link za video poziv i uputstvo za plaćanje.` },
        { title: 'Prvi razgovor', text: 'Pričamo o tome šta te muči, šta želiš da promeniš i da li ti ovakav rad odgovara. Bez obaveze da nastaviš.' },
      ]} />
    </div>
  </section>

  <section class="section" aria-labelledby="pitanja-naslov">
    <div class="container editorial">
      <div class="editorial__head stack">
        <Eyebrow tone="red">Pre zakazivanja</Eyebrow>
        <h2 id="pitanja-naslov" class="h2">Česta pitanja o terminima</h2>
        <div style="margin-top:var(--space-8)"><CrisisNote /></div>
      </div>
      <div class="editorial__body"><Faq items={faq} /></div>
    </div>
  </section>
</Base>
