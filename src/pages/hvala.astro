---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import CrisisNote from '../components/CrisisNote.astro';
import { practice } from '../data/practice';
---
<Base title="Poruka je stigla" description="Hvala na poruci. Odgovor stiže emailom." noindex>
  <section class="section">
    <div class="container stack" style="max-width:720px">
      <Eyebrow tone="lime">Poslato</Eyebrow>
      <h1 class="h1">Hvala. Poruka je stigla.</h1>
      <p class="lead muted">Prvi korak je iza tebe. {practice.responseTime} Odgovor stiže na tvoj email, pa proveri i neželjenu poštu.</p>
      <div style="display:flex;flex-wrap:wrap;gap:var(--space-4) var(--space-8);align-items:center;margin:var(--space-6) 0 var(--space-10)">
        <Button href="/kako-radim/" variant="secondary">Kako izgleda terapija</Button>
        <Button href="/" variant="link">Na početnu</Button>
      </div>
      <CrisisNote />
    </div>
  </section>
</Base>
