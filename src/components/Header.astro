---
import Button from './Button.astro';
import { mainNav } from '../data/nav';
import { site } from '../data/practice';
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="rh-header">
  <div class="container rh-header__bar">
    <a class="rh-header__logo" href="/" aria-label={`${site.brand}, početna`}>
      <img src="/logo.svg" alt="" width="128" height="35" />
    </a>
    <nav class="rh-header__nav" aria-label="Glavni meni">
      <ul class="rh-header__list">
        {mainNav.map((item) => (
          <li><a class="rh-header__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="rh-header__action">
      <!-- Bez JavaScripta dugme ostaje skriveno, a tema prati podešavanje uređaja. -->
      <button class="rh-theme" id="rh-theme" type="button" aria-label="Tamna tema" aria-pressed="false" title="Svetla ili tamna tema" hidden>
        <svg class="rh-theme__sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg>
        <svg class="rh-theme__moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19.5 14.6A7.5 7.5 0 0 1 9.4 4.5a7.5 7.5 0 1 0 10.1 10.1Z" /></svg>
      </button>
      <Button href="/zakazivanje/" size="sm" star>Zakaži</Button>
    </div>
  </div>
</header>
<!-- Na telefonu je traka sa logom i dugmetom „Zakaži“ uvek vidljiva, a meni je red ispod nje. -->
<nav class="rh-subnav" aria-label="Meni">
  <ul class="rh-header__list">
    {mainNav.map((item) => (
      <li><a class="rh-header__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
    ))}
  </ul>
</nav>
<script is:inline>
(function () {
  var b = document.getElementById('rh-theme');
  if (!b) return;
  var r = document.documentElement;
  var q = window.matchMedia('(prefers-color-scheme: dark)');
  function current() { return r.getAttribute('data-theme') || (q.matches ? 'dark' : 'light'); }
  function sync() {
    var dark = current() === 'dark';
    b.setAttribute('aria-pressed', String(dark));
    document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) { m.setAttribute('content', dark ? '#161618' : '#f8f7f4'); });
  }
  b.hidden = false;
  sync();
  q.addEventListener('change', sync);
  b.addEventListener('click', function () {
    var next = current() === 'dark' ? 'light' : 'dark';
    r.setAttribute('data-theme', next);
    try { localStorage.setItem('rh-theme', next); } catch (e) {}
    sync();
  });
})();
</script>
