---
/**
 * Kratka forma za prvi kontakt: ime, email, „Odakle znaš za mene?“ i opciono par reči.
 * Ne pita za dijagnozu ni zdravstvene podatke. Radi bez JavaScripta (običan POST),
 * a servis posle slanja vraća posetioca na /hvala/.
 * Dok practice.form.endpoint nije upisan, forma se vidi samo u dev režimu.
 */
import { practice } from '../data/practice';
const { endpoint, hidden, honeypot } = practice.form;
const live = Boolean(endpoint);
const show = live || import.meta.env.DEV;
const sources = ['Instagram', 'Google pretraga', 'Preporuka', 'AI asistent (ChatGPT i slični)', 'Nešto drugo'];
---
{show && (
  <form class="rh-form" action={endpoint ?? undefined} method="post" accept-charset="utf-8">
    {!live && <p class="rh-devnote">Vidi se samo u dev režimu: forma se objavljuje kad se upiše practice.form.endpoint.</p>}
    {Object.entries(hidden).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
    <div class="rh-form__trap" aria-hidden="true">
      <label>Ne popunjavaj ovo polje <input type="text" name={honeypot} tabindex="-1" autocomplete="off" /></label>
    </div>
    <div class="rh-field">
      <label class="rh-field__label" for="f-ime">Ime</label>
      <input class="rh-field__control" id="f-ime" name="ime" type="text" autocomplete="given-name" required />
    </div>
    <div class="rh-field">
      <label class="rh-field__label" for="f-email">Email</label>
      <input class="rh-field__control" id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="f-email-hint" />
      <p class="rh-field__hint" id="f-email-hint">Na ovu adresu ti odgovaram. {practice.responseTime}</p>
    </div>
    <div class="rh-field">
      <label class="rh-field__label" for="f-odakle">Odakle znaš za mene? <span class="rh-field__optional">(opciono)</span></label>
      <select class="rh-field__control" id="f-odakle" name="odakle">
        <option value="">Izaberi</option>
        {sources.map((s) => <option>{s}</option>)}
      </select>
    </div>
    <div class="rh-field">
      <label class="rh-field__label" for="f-poruka">Par reči o tome zašto se javljaš <span class="rh-field__optional">(opciono)</span></label>
      <textarea class="rh-field__control" id="f-poruka" name="poruka" rows="4" aria-describedby="f-poruka-hint"></textarea>
      <p class="rh-field__hint" id="f-poruka-hint">Dovoljna je jedna rečenica. Ne moraš da znaš kako se to zove.</p>
    </div>
    <div class="rh-form__foot">
      <button class="rh-btn rh-btn--primary" type="submit" disabled={!live}>Pošalji poruku</button>
      <p class="small muted">Podatke koristim samo da ti odgovorim. <a class="rh-link" href="/privatnost/">Politika privatnosti</a></p>
    </div>
  </form>
)}
